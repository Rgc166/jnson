<Window x:Class="VeyonSync.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="VeyonSync" Width="1240" Height="790" MinWidth="880" MinHeight="600" WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition x:Name="NavColumn" Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="{DynamicResource Sidebar}" Padding="16,24,12,16">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top"><TextBlock x:Name="Brand" Text="VEYONSYNC" FontSize="21" FontWeight="Bold" Margin="6,0,0,6"/><TextBlock x:Name="RoleLabel" Foreground="{DynamicResource Muted}" Margin="6,0,0,24"/><Button Content="☰" ToolTip="Recolher ou expandir menu" AutomationProperties.Name="Recolher ou expandir menu" Click="CollapseMenu" HorizontalContentAlignment="Left"/></StackPanel>
        <StackPanel DockPanel.Dock="Bottom"><TextBlock x:Name="VersionLabel" Text="v0.2.0 · Windows" Foreground="{DynamicResource Muted}" FontSize="12" Margin="6,12,0,0"/></StackPanel>
        <StackPanel x:Name="Navigation"/>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="28,22,28,18">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,22">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><TextBlock Text="{Binding Clock}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="8,0,16,8"/><Button Content="◐ Tema" Click="ChangeTheme" ToolTip="Alternar entre escuro, claro e tema do Windows"/><Button Content="⚙" Click="OpenSettings" AutomationProperties.Name="Abrir configurações"/></StackPanel>
        <StackPanel><TextBlock Text="{Binding Heading}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding Service}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,5,0,0"/></StackPanel>
      </DockPanel>
      <TextBlock Grid.Row="1" x:Name="PageTitle" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,18"/>
      <Border Grid.Row="2" Background="{DynamicResource Card}" CornerRadius="8" Padding="12" Margin="0,0,0,16"><TextBlock Text="{Binding Message}" Foreground="{DynamicResource Muted}" AutomationProperties.LiveSetting="Polite"/></Border>
      <ContentControl Grid.Row="3" x:Name="PageContent"/>
    </Grid>
  </Grid>
</Window>
